# Copy to spel/db/.env (gitignored) and fill in. All variables are optional for local development.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only (behind TLS-terminating Nginx):
# DJANGO_SECURE_PROXY_SSL_HEADER=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# --- Database ---
# sqlite (default): the file is SPEL_DB_PATH, default spel/db/explorer.sqlite3
DB_ENGINE=sqlite
# SPEL_DB_PATH=/path/to/explorer.sqlite3
# mysql / MariaDB:
# DB_ENGINE=mysql
# DB_NAME=spelapp
# DB_USER=djuser
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_CONN_MAX_AGE=3600

# --- Accounts ---
REGISTRATION_OPEN=true
INVITE_CODE=

# --- Static/media (collectstatic targets) ---
# STATIC_ROOT=/opt/app/static
# MEDIA_ROOT=/opt/app/media
